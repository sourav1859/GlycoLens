# Application
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
GLYCOLENS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase
# Exact dedicated development target; live test runners reject other projects.
GLYCOLENS_CLOUD_PROJECT_REF=ecynkzptuslkuhjikzfc
SUPABASE_URL=
# Client-safe publishable key; this existing variable name is retained for compatibility.
SUPABASE_ANON_KEY=
# Preferred server-only key (sb_secret_...). Never place in frontend configuration.
SUPABASE_SECRET_KEY=
# Optional legacy JWT fallback when SUPABASE_SECRET_KEY is not set.
SUPABASE_SERVICE_ROLE_KEY=

# Nutrition services
USDA_FDC_API_KEY=
# Supply the project contact only in private configuration before live OFF reads.
OPEN_FOOD_FACTS_USER_AGENT=

# Dexcom Developer Sandbox
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
DEXCOM_REDIRECT_URI=http://localhost:8000/api/dexcom/callback
DEXCOM_BASE_URL=https://sandbox-api.dexcom.com

# Optional structured recipe parser
LLM_API_KEY=
LLM_MODEL=gpt-6-luna

# Research defaults
GLYCOLENS_DATA_DIR=./data
GLYCOLENS_ARTIFACT_DIR=./artifacts
GLYCOLENS_T1D_UOM_ROOT=

# Private advisor email routing; keep real values in ignored .env only
GLYCOLENS_ADVISOR_EMAIL_SENDER=
GLYCOLENS_ADVISOR_EMAIL_RECIPIENT=
# Optional local Compose overrides; the default command needs no domain.
GLYCOLENS_WEB_PORT=3000
GLYCOLENS_API_PORT=8000
GLYCOLENS_MODEL_CACHE=./artifacts/models/huggingface
GLYCOLENS_SIMULATION_ARTIFACTS=./artifacts/simulation
# Optional verified native research model. Chronos remains the default.
GLYCOLENS_LIGHTGBM_ENABLED=false
GLYCOLENS_LIGHTGBM_MANIFEST_SHA256=
# Host path for the narrow read-only Compose bundle mount (no research data).
GLYCOLENS_LIGHTGBM_BUNDLE=./artifacts/models/lightgbm
