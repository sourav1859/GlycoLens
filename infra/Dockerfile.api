FROM ghcr.io/astral-sh/uv:0.9.18@sha256:5713fa8217f92b80223bc83aac7db36ec80a84437dbc0d04bbc659cae030d8c9 AS uv
FROM python:3.12.5-slim-bookworm@sha256:c24c34b502635f1f7c4e99dc09a2cbd85d480b7dcfd077198c6b5af138906390
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PYTHON_DOWNLOADS=never HF_HUB_OFFLINE=1
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends git libgomp1 && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 glycolens && useradd --uid 10001 --gid 10001 --create-home glycolens
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group chronos --no-install-project
COPY research/simulation/pymgipsim-requirements.lock /opt/simulator-requirements.lock
RUN uv venv /opt/simulator --python /usr/local/bin/python && uv pip sync --python /opt/simulator/bin/python /opt/simulator-requirements.lock
# Source-only simulator has its own incompatible dependency graph and verified Git commit.
RUN git init /opt/pymgipsim && git -C /opt/pymgipsim remote add origin https://github.com/illinoistech-itm/py-mgipsim.git && git -C /opt/pymgipsim fetch --depth 1 origin b985f8c2ea385d1b2b8480957b730866e07772f1 && git -C /opt/pymgipsim checkout --detach FETCH_HEAD && test "$(git -C /opt/pymgipsim rev-parse HEAD)" = b985f8c2ea385d1b2b8480957b730866e07772f1
ENV GLYCOLENS_SIMULATOR_SOURCE_DIR=/opt/pymgipsim GLYCOLENS_SIMULATOR_PYTHON=/opt/simulator/bin/python NUMBA_CACHE_DIR=/tmp/numba MPLCONFIGDIR=/tmp/matplotlib
RUN mkdir -p /opt/pymgipsim/SimulationResults && chown 10001:10001 /opt/pymgipsim/SimulationResults
COPY backend ./backend
COPY research ./research
COPY scripts/dev/check_container_runtime.py ./scripts/dev/check_container_runtime.py
RUN mkdir -p /app/artifacts/simulation /app/artifacts/models/huggingface && chown -R 10001:10001 /app/artifacts
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD ["/app/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)"]
CMD ["/app/.venv/bin/python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
