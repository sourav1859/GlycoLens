# Public browser configuration only. Secret/backend/provider keys belong in root .env.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
# Accepts a modern publishable key; variable name retained for compatibility.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable only after real verification/recovery delivery is configured and tested.
NEXT_PUBLIC_AUTH_EMAIL_DELIVERY_ENABLED=false
